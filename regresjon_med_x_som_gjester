import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt
import re
import os

# 1. Last inn Airbnb-filen
input_file = "listings.csv"
df = pd.read_csv(input_file)

# 2. Datavasking: Gjør pris-kolonnen numerisk
def clean_price(price_val):
    if pd.isna(price_val):
        return np.nan
    cleaned = re.sub(re.compile(r'[^\d.]'), '', str(price_val).replace(',', '.'))
    try:
        return float(cleaned)
    except ValueError:
        return np.nan

df['Cleaned_Price'] = df['price_quote_total_price'].apply(clean_price)

# Sjekker sekundær pris-kolonne om totalpris mangler
if df['Cleaned_Price'].isna().sum() > 0:
    df['Cleaned_Price'] = df['Cleaned_Price'].fillna(df['price'].apply(clean_price))

# Fjern rader med manglende verdier i aksene våre
df_plots = df.dropna(subset=['Cleaned_Price', 'accommodates']).copy()

# 3. Opprett en ny mappe for disse diagrammene
output_dir = "airbnb_pris_basert_pa_størrelse"
if not os.path.exists(output_dir):
    os.makedirs(output_dir)

# 4. Grupper etter område og generer plot for hver gruppe
location_column = "neighbourhood_cleansed"
grouped = df_plots.groupby(location_column)

# Sett visuell stil
sns.set_theme(style="whitegrid")

print("Genererer og lagrer oppdaterte diagrammer...")

for location, group in grouped:
    # Hopper over områder med mindre enn 3 datapunkter
    if len(group) < 3:
        print(f"  -> {location}: For få datapunkter ({len(group)}). Skipper diagram.")
        continue
        
    plt.figure(figsize=(10, 6))
    
    # Lag regresjonsplottet der x=gjester/størrelse og y=pris
    sns.regplot(
        data=group, 
        x='accommodates', 
        y='Cleaned_Price', 
        scatter_kws={'alpha':0.6, 'color': '#2ca02c', 's': 60}, # Grønne punkter for data
        line_kws={'color': '#ff7f0e', 'linewidth': 2},          # Oransje regresjonslinje
        ci=95
    )
    
    # Siden antall gjester alltid er hele tall (1, 2, 3, 4...), 
    # tvinger vi x-aksen til å kun vise hele tall for bedre lesbarhet
    max_guests = int(group['accommodates'].max())
    min_guests = int(group['accommodates'].min())
    plt.xticks(range(min_guests, max_guests + 1))
    
    # Skreddersy titler og merkelapper på aksene
    safe_location_name = str(location).replace("/", "-").replace(" ", "_")
    plt.title(f"Prisutvikling basert på kapasitet i {location}", fontsize=14, fontweight='bold', pad=15)
    plt.xlabel("Størrelse / Kapasitet (X-akse: antall gjester)", fontsize=12)
    plt.ylabel("Pris i NOK (Y-akse)", fontsize=12)
    
    plt.tight_layout()
    
    # Lagre plottet som en PNG-fil i den nye mappen
    file_path = os.path.join(output_dir, f"pris_regresjon_{safe_location_name}.png")
    plt.savefig(file_path, dpi=300)
    plt.close()
    
    print(f"  [OK] Lagret: {file_path}")

print(f"\nFerdig! Alle de nye diagrammene er lagret i mappen: '{output_dir}/'")
