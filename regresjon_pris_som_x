import pandas as pd
import re

# 1. Last inn Airbnb-filen din (erstatt med ditt faktiske filnavn)
input_file = "listings.csv"
df = pd.read_csv(input_file)

# 2. Grupper datasettet basert på Airbnb-bydel
# Vi bruker 'neighbourhood_cleansed' da denne har de offisielle bydelene (f.eks. Frogner, Gamle Oslo, Sagene)
location_column = "neighbourhood_cleansed"

for location, group in df.groupby(location_column):
    # Hvis en lokasjon mangler navn, hopper vi over eller kaller den 'Ukjent'
    if pd.isna(location) or str(location).strip() == "":
        location = "Ukjent"
    
    # Gjør navnet trygt for filsystemet (fjerner tegn som ikke tåles i filnavn)
    safe_location = re.sub(re.compile(r'[\\/*?:"<>|]'), "", str(location))
    safe_location = safe_location.replace(" ", "_")
    
    # 3. Generer filnavn og lagre den nye CSV-filen
    output_filename = f"airbnb_{safe_location}.csv"
    group.to_csv(output_filename, index=False)
    
    print(f"Opprettet fil for {location}: '{output_filename}' ({len(group)} rader)")

print("\nOppdelingen er fullført!")





