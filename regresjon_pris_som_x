import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt
import re
import os

# 1. Last inn Airbnb-filen
input_file = "listings.csv"
df = pd.read_csv(input_file)

# 2. Datavasking: Gjør pris-kolonnen numerisk
def clean_price(price_val):
    if pd.isna(price_val):
        return np.nan
    cleaned = re.sub(re.compile(r'[^\d.]'), '', str(price_val).replace(',', '.'))
    try:
        return float(cleaned)
    except ValueError:
        return np.nan

df['Cleaned_Price'] = df['price_quote_total_price'].apply(clean_price)

# Sjekker sekundær pris-kolonne om totalpris mangler
if df['Cleaned_Price'].isna().sum() > 0:
    df['Cleaned_Price'] = df['Cleaned_Price'].fillna(df['price'].apply(clean_price))

# Fjern rader med manglende verdier i aksene våre
df_plots = df.dropna(subset=['Cleaned_Price', 'accommodates']).copy()

# 3. Opprett en mappe for å lagre bildene hvis den ikke eksisterer
output_dir = "airbnb_plots"
if not os.path.exists(output_dir):
    os.makedirs(output_dir)

# 4. Grupper etter område og generer plot for hver gruppe
location_column = "neighbourhood_cleansed"
grouped = df_plots.groupby(location_column)

# Sett visuell stil for diagrammene
sns.set_theme(style="whitegrid")

print("Genererer og lagrer diagrammer...")

for location, group in grouped:
    # Hopper over områder med mindre enn 3 datapunkter
    if len(group) < 3:
        print(f"  -> {location}: For få datapunkter ({len(group)}). Skipper diagram.")
        continue
        
    # Opprett et nytt diagram-vindu
    plt.figure(figsize=(10, 6))
    
    # Lag regresjonsplottet (X = Pris, Y = Størrelse/Kapasitet)
    # ci=95 legger til et 95% konfidensintervall rundt linjen
    sns.regplot(
        data=group, 
        x='Cleaned_Price', 
        y='accommodates', 
        scatter_kws={'alpha':0.6, 'color': '#1f77b4', 's': 50}, 
        line_kws={'color': '#d62728', 'linewidth': 2},
        ci=95
    )
    
    # Skreddersy titler og merkelapper på aksene
    safe_location_name = str(location).replace("/", "-").replace(" ", "_")
    plt.title(f"Regresjonsanalyse for {location}\n(Størrelse basert på pris)", fontsize=14, fontweight='bold', pad=15)
    plt.xlabel("Pris (X-akse)", fontsize=12)
    plt.ylabel("Størrelse / Kapasitet (Y-akse: antall gjester)", fontsize=12)
    
    # Tilpass kantene slik at ingenting blir kuttet bort
    plt.tight_layout()
    
    # Lagre plottet som en PNG-fil i mappen
    file_path = os.path.join(output_dir, f"regresjon_{safe_location_name}.png")
    plt.savefig(file_path, dpi=300)
    
    # Lukk diagram-vinduet for å frigjøre minne til neste område
    plt.close()
    
    print(f"  [OK] Lagret: {file_path}")

print(f"\nFerdig! Alle diagrammer er lagret i mappen: '{output_dir}/'")
